{
  "$schema": "https://schema.tauri.app/config_2",
  "identifier": "com.radial.builder",
  "productName": "Radial Menu Builder++ for Plasticity",
  "version": "1.3.5",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["radial"]
    },
    "windows": [
      {
  "title": "Radial Menu Builder++ for Plasticity",
  "width": 1200,
  "height": 800,
  "resizable": true,
  "dragDropEnabled": false
}
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../TERMS-OF-USE.txt": "TERMS-OF-USE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "upgradeCode": "e105f458-ab25-5db4-b8b2-bb79d94a174f"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "entitlements": "app.entitlements",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {}
}